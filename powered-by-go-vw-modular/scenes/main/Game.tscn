[gd_scene format=3]

[ext_resource type="Script" path="res://core/network/GameManager.gd" id="1_game"]
[ext_resource type="PackedScene" path="res://scenes/ui/HUD.tscn" id="2_hud"]
[ext_resource type="PackedScene" path="res://scenes/world/World.tscn" id="3_world"]
[ext_resource type="PackedScene" path="res://scenes/inventoryui/inventory.tscn" id="4_inventory"]
[ext_resource type="PackedScene" path="res://scenes/player/Player.tscn" id="5_player"]

[node name="Game" type="Node3D"]
script = ExtResource("1_game")
player_scene = ExtResource("5_player")

[node name="World" parent="." instance=ExtResource("3_world")]

[node name="UI" type="CanvasLayer" parent="."]

[node name="HUD" parent="UI" instance=ExtResource("2_hud")]

[node name="InventoryUI" parent="UI" instance=ExtResource("4_inventory")]

[node name="Players" type="Node" parent="."]

[node name="SpawnPoint" type="Marker3D" parent="Players"]
